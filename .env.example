FORM_TO_EMAIL=mamjed@myist.org
CAREERS_TO_EMAIL=jobs@myist.org
# Required in production. Forms return 503 instead of pretending to send without these.
RESEND_API_KEY=
RESEND_FROM_EMAIL=IST Website <website@your-verified-domain.example>

# Server-only upstream; browsers use the same-origin /api/prayers proxy.
PRAYER_CLOCK_API_URL=http://142.93.61.217

NEXT_PUBLIC_DONATE_URL=https://app.irm.io/islamicsocietyoftoronto.com
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/CAAwHH6yUf5H2JFn8rF73c
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/islamicsocietyoftoronto
# Optional: Meta Graph API for the most reliable live feed (Business/Creator account)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
# Optional: comma-separated Instagram post/reel URLs to seed into the carousel/grid
# NEXT_PUBLIC_INSTAGRAM_POSTS=https://www.instagram.com/p/XXXX/,https://www.instagram.com/reel/YYYY/
# Manage / refresh the grid anytime in Admin → Instagram

# Required in production. Development uses Cloudflare's test keys when omitted.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Required before the first production start. JWT secret must be 32+ characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Production content store. Omit DATABASE_URL to use local SQLite at data/ist.db.
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_SIZE=10

# S3-compatible uploads. Omit S3_BUCKET to use public/uploads locally.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
